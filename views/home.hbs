<h1>Student Management System</h1>
<div class="add_student_wrap">
    <a href="/add-student" class="add_student">Add Students</a>
</div>
<table>
    <thead></thead>
    <tr>
        <th>#</th>
        <th>Name</th>
        <th>Age</th>
        <th>City</th>
        <th>Edit</th>
        <th>Delete</th>

    </tr>
    <tbody>
        {{#each rows}}
        <tr>
            <td>{{id}}</td>
            <td>{{NAME}}</td>
            <td>{{age}}</td>
            <td>{{city}}</td>
            <td>
                <div class="action_wrapper">
                    <a href="edit-student/{{id}}" class="edit">Edit</a>
                </div>
            </td>
            <td>
                <div class="action_wrapper">
                    {{!-- <a onclick="return confirm('Are you sure?')" href="/delete-student/{{id}}"
                        class="delete">Delete</a> --}}
                    <form method="POST" action="/delete-student/{{id}}">
                        <button type="submit" class="delete">Delete</button>

                    </form>
                </div>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>